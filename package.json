{
  "name": "vesti-app",
  "productName": "Vesti",
  "version": "0.2.1",
  "description": "Local-first desktop hub for AI conversation capture and reflection",
  "author": "VESTI Team",
  "private": true,
  "main": ".vite/build/main.js",
  "scripts": {
    "core:build": "pnpm --filter @vesti/capture-core build",
    "native:prepare": "node scripts/prepare-native.mjs",
    "electron:cache": "node scripts/prepare-electron-zip.mjs",
    "start": "pnpm core:build && pnpm native:prepare && electron-forge start",
    "typecheck": "pnpm core:build && tsc --noEmit",
    "package": "pnpm core:build && pnpm native:prepare && pnpm electron:cache && electron-forge package",
    "make": "pnpm package && electron-builder --prepackaged out/Vesti-win32-x64 --win nsis --config electron-builder.yml"
  },
  "dependencies": {
    "@vesti/capture-core": "workspace:*",
    "better-sqlite3": "12.10.0",
    "chokidar": "^4.0.3",
    "fs-extra": "^11.3.2",
    "glob": "^11.0.3",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "7.11.2",
    "@electron-forge/plugin-vite": "7.11.2",
    "@electron-forge/shared-types": "7.11.2",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "41.10.1",
    "electron-builder": "26.15.6",
    "tslib": "2.8.1",
    "typescript": "^5.9.3",
    "vite": "8.1.4"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "pnpm": {
    "overrides": {
      "@vesti/capture-core>better-sqlite3": "12.10.0"
    },
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "electron"
    ]
  },
  "packageManager": "pnpm@10.34.4"
}
